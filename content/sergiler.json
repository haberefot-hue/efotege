      "ad": "Sokak",
      "yil": "2026",
      "tarih_yer": "22 Mayıs – 12 Haziran 2026 · Ege Üniversitesi Merkez Kütüphanesi",
      "afis": "/images/sergiler/sokak/afis.webp",
